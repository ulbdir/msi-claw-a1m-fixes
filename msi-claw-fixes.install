post_install() {
    echo ":: MSI Claw A1M fixes applied."
    echo ":: Please reboot your device to activate the Intel Xe driver and sleep settings."
}

post_upgrade() {
    post_install
}

post_remove() {
    echo ":: MSI Claw A1M fixes removed."
    echo ":: Please reboot your device to revert to default kernel and power settings."
}
